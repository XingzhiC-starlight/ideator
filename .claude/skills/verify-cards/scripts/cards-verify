#!/bin/bash
# cards-verify: build, launch, drive, capture and stop an isolated Cards instance.
# Run with no arguments for usage. See ../SKILL.md for the recipe.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$SKILL_DIR/../../.." && pwd)"
DERIVED="$REPO/build/VerifyDerivedData"
APP="$DERIVED/Build/Products/Debug/Ideator.app"
BIN="$APP/Contents/MacOS/Ideator"
AX="$REPO/build/verify-tools/cards-ax"
CLIP="$REPO/build/verify-tools/cards-clip"
MCP="$REPO/build/verify-tools/cards-mcp"
HELPER="$APP/Contents/Helpers/ideator-mcp"
RUNS="$REPO/build/verify-runs"
EVIDENCE_ROOT="$REPO/build/verify-evidence"
# shellcheck disable=SC1091
source "$SKILL_DIR/scripts/live-lock.sh"

usage() {
  cat <<'EOF'
cards-verify build                  build Ideator into build/VerifyDerivedData and compile cards-ax, cards-clip and cards-mcp
cards-verify launch [--welcome] [--seed [SIDECAR]]  take the live-UI lock, then start an isolated instance on an empty temp folder (refuses while another session holds the lock; --welcome: show the first-launch welcome and its tour, wait for the Start the tour button; --seed: two stacked cards; SIDECAR: a .cards.json to start from, with the .md files beside it when it is named .cards.json, as `files` saves it)
cards-verify doctor                 read-only health check of the current run, and who holds the live-UI lock
cards-verify ax COMMAND ARGS...     cards-ax against the current run's pid (tree, press, text, click, focus, type, key, scroll, drag, windows, act, section, where, mouse, dragat, listen)
cards-verify shot NAME              screenshot every window + accessibility tree into the evidence folder
cards-verify files NAME             copy the card folder (*.md and .cards.json) into the evidence folder and print it
cards-verify note TEXT              append a line to the run's evidence log
cards-verify clip save              keep the owner's clipboard (every type) until restore; set refuses without it
cards-verify clip set TEXT [HTML]   the clipboard holds TEXT as plain text, and HTML as public.html
cards-verify clip show              the clipboard's types, plain text and HTML (what a copy wrote)
cards-verify clip restore           put the owner's clipboard back (stop does this too if you forget)
cards-verify mcp STEP...            one MCP session through this build's helper, on this run's folder (steps: see scripts/cards-mcp.swift)
cards-verify mcp-launch STEP...     take the live-UI lock, then the same with no app running: the helper starts this build on a new temp folder, which becomes the current run
cards-verify stop                   quit the instance this run started, release the lock this run took, delete its temp folder, keep evidence
cards-verify env                    print RUN_ID, PID, FOLDER, EVIDENCE of the current run
EOF
}

die() { echo "cards-verify: $*" >&2; exit 1; }

current() {
  [[ -f "$RUNS/current.env" ]] || die "no current run; start one with: cards-verify launch"
  # shellcheck disable=SC1091
  source "$RUNS/current.env"
}

ours() {  # true when PID is alive and is the binary this run launched on this run's folder
  local cmd
  cmd="$(ps -o command= -p "$PID" 2>/dev/null || true)"
  [[ "$cmd" == "$BIN -CardsFolder $FOLDER"* ]]
}

idle_note() {
  local ref="$EVIDENCE/.helper-event" label="helper event" out
  [[ -f "$ref" ]] || { ref="$RUNS/current.env"; label=launch; }
  out="$("$AX" idle "$ref" "$label" 2>/dev/null)" || return 0
  echo " [$out]"
}

log_line() { echo "$(date '+%H:%M:%S') $*$(idle_note)"; }
log() { log_line "$@" | tee -a "$EVIDENCE/log.txt"; }

build() {
  xcodebuild -project "$REPO/Cards.xcodeproj" -scheme Ideator -configuration Debug \
    -derivedDataPath "$DERIVED" -disableAutomaticPackageResolution build -quiet
  local tool src
  for tool in cards-ax cards-clip cards-mcp; do
    src="$SKILL_DIR/scripts/$tool.swift"
    if [[ ! -x "$REPO/build/verify-tools/$tool" || "$src" -nt "$REPO/build/verify-tools/$tool" ]]; then
      mkdir -p "$REPO/build/verify-tools"
      swiftc -O "$src" -o "$REPO/build/verify-tools/$tool"
    fi
  done
  echo "built $APP"
}

launch() {
  [[ -x "$BIN" && -x "$AX" ]] || die "not built; run: cards-verify build"
  if [[ -f "$RUNS/current.env" ]]; then
    current
    if ours; then die "run $RUN_ID (pid $PID) is still up; stop it first: cards-verify stop"; fi
    [[ -z "${LOCK_TOKEN:-}" ]] || live_lock_release "$LOCK_TOKEN" || true
  fi
  local run_id folder evidence pid="" ready=New env=() mode="$*" lock_token
  if [[ "${1:-}" == "--welcome" ]]; then
    # An environment variable, not an argument, so the command line pgrep and ours() match stays as is.
    env=(--env CARDS_SHOW_WELCOME=1)
    ready="Start the tour"
    shift
  fi
  run_id="$(date '+%Y%m%d-%H%M%S')"
  lock_token="cards-verify run $run_id in $REPO since $(date '+%H:%M:%S')"
  live_lock_take "$lock_token" || die "another live Ideator session holds $LIVE_LOCK (holder: $(live_lock_holder)); retry in 30 s"
  trap 'live_lock_release "$lock_token" || true' EXIT
  # Cards writes here, so keep it out of ~/Desktop and ~/Documents: those trigger a privacy prompt.
  folder="${TMPDIR:-/tmp/}cards-verify/$run_id/folder"
  folder="${folder//\/\//\/}"
  evidence="$EVIDENCE_ROOT/$run_id"
  mkdir -p "$folder" "$evidence" "$RUNS"
  if [[ "${1:-}" == "--seed" ]]; then
    printf '# Alpha card\n\nalpha body\n' > "$folder/seed-a.md"
    printf '# Beta card\n\nbeta line one\nbeta line two\n' > "$folder/seed-b.md"
    if [[ -n "${2:-}" ]]; then
      # A sidecar `files` saved comes with its cards: without their .md files the app drops what it names.
      if [[ "$(basename "$2")" == ".cards.json" ]]; then cp "$(dirname "$2")"/*.md "$folder/" 2>/dev/null || true; fi
      cp "$2" "$folder/.cards.json"
    fi
  fi
  # `open -n` detaches the app from this shell (a child of the shell dies with it) and starts a new
  # instance even while the owner's Cards runs. Every later step targets the pid, never the name.
  open -n ${env[@]+"${env[@]}"} --stdout "$evidence/app.log" --stderr "$evidence/app.log" "$APP" --args -CardsFolder "$folder"
  for _ in $(seq 1 50); do
    pid="$(pgrep -f -- "-CardsFolder $folder\$" || true)"
    [[ -n "$pid" ]] && break
    sleep 0.2
  done
  [[ -n "$pid" ]] || die "Cards did not start; see $evidence/app.log"
  printf 'RUN_ID=%q\nPID=%q\nFOLDER=%q\nEVIDENCE=%q\nLOCK_TOKEN=%q\n' "$run_id" "$pid" "$folder" "$evidence" "$lock_token" > "$RUNS/current.env"
  trap - EXIT
  current
  for _ in $(seq 1 50); do
    if "$AX" tree "$PID" 2>/dev/null | grep -q "\"$ready\""; then
      log "launched run $RUN_ID pid $PID folder $FOLDER${mode:+ ($mode)}"
      echo "evidence: $EVIDENCE"
      return
    fi
    sleep 0.2
  done
  die "pid $PID is up but its $ready button never appeared; run: cards-verify doctor"
}

doctor() {
  LOCK_TOKEN=""
  [[ -f "$RUNS/current.env" ]] && current
  local ok=1
  if [[ ! -d "$LIVE_LOCK" ]]; then echo "lock      none: nobody holds $LIVE_LOCK"
  elif [[ -n "$LOCK_TOKEN" ]] && live_lock_held_by "$LOCK_TOKEN"; then echo "lock      ok: this run holds $LIVE_LOCK ($(live_lock_holder))"
  elif [[ -n "$LOCK_TOKEN" ]]; then echo "lock      FAIL: this run's lock was replaced; $LIVE_LOCK is held by: $(live_lock_holder)"; ok=0
  else echo "lock      held by another session: $(live_lock_holder)"; fi
  [[ -f "$RUNS/current.env" ]] || die "no current run; start one with: cards-verify launch"
  echo "run       $RUN_ID"
  if ours; then echo "process   ok: pid $PID is $BIN on $FOLDER"; else echo "process   FAIL: pid $PID is not this run's Cards (gone, or reused)"; ok=0; fi
  local newest
  newest="$(find "$REPO/Cards" "$REPO/MCP" "$REPO/Helper" -name '*.swift' -newer "$BIN" | head -1)"
  if [[ -z "$newest" ]]; then echo "build     ok: no source newer than the binary"; else echo "build     STALE: $newest is newer than the binary; run: cards-verify build, then relaunch"; ok=0; fi
  if [[ -d "$FOLDER" ]]; then echo "folder    ok: $(ls -A "$FOLDER" | wc -l | tr -d ' ') entries in $FOLDER"; else echo "folder    FAIL: $FOLDER is missing"; ok=0; fi
  if [[ $ok == 1 ]] && "$AX" tree "$PID" > /tmp/cards-verify-doctor.$$ 2>&1; then
    local windows
    windows="$(grep -c '^w' /tmp/cards-verify-doctor.$$ || true)"
    if grep -q '"New"' /tmp/cards-verify-doctor.$$; then echo "ui        ok: $windows window(s), stack answers"
    elif grep -q -e '"Start the tour"' -e '"Continue"' /tmp/cards-verify-doctor.$$; then echo "ui        ok: $windows window(s), the welcome answers"
    else echo "ui        FAIL: no stack window or welcome in the accessibility tree"; ok=0; fi
  else
    echo "ui        FAIL: $(cat /tmp/cards-verify-doctor.$$ 2>/dev/null)"; ok=0
  fi
  rm -f /tmp/cards-verify-doctor.$$
  local others
  others="$(pgrep -f 'Ideator.app/Contents/MacOS/Ideator' | grep -vx "$PID" | tr '\n' ' ' || true)"
  [[ -n "$others" ]] && echo "others    note: other Cards processes (not ours, never drive them): $others"
  [[ $ok == 1 ]] && echo "healthy" || { echo "UNHEALTHY"; return 1; }
}

ax() {
  current
  ours || die "pid $PID is not this run's Cards; run: cards-verify doctor"
  local cmd="$1"; shift
  local what="ax $cmd${*:+ $*}"
  [[ "$cmd" == type ]] && what="ax type <${#1} characters>"
  what="${what//$'\n'/ }"
  log_line "${what:0:80}" >> "$EVIDENCE/log.txt"
  CARDS_AX_STAMP="$EVIDENCE/.helper-event" "$AX" "$cmd" "$PID" "$@"
}

shot() {
  current
  local name="$1"
  ours || die "pid $PID is not this run's Cards"
  "$AX" tree "$PID" > "$EVIDENCE/$name.tree.txt"
  local n=0
  while read -r id _; do
    [[ -n "$id" ]] || continue
    # A window mid-animation (a flip, a snap) can refuse once; retry before giving up on it.
    if screencapture -x -o -l "$id" "$EVIDENCE/$name-$id.png" 2>/dev/null \
      || { sleep 0.5; screencapture -x -o -l "$id" "$EVIDENCE/$name-$id.png"; }; then
      n=$((n + 1))
    else
      log "shot $name: window $id could not be captured"
    fi
  done < <("$AX" windows "$PID")
  log "shot $name: $n window(s), tree in $name.tree.txt"
}

files() {
  current
  local name="$1" out="$EVIDENCE/$1-files"
  mkdir -p "$out"
  cp -p "$FOLDER"/*.md "$out"/ 2>/dev/null || true
  cp -p "$FOLDER/.cards.json" "$out"/ 2>/dev/null || true
  log "files $name: $(ls -A "$FOLDER" | tr '\n' ' ')"
  for f in "$FOLDER"/*.md; do [[ -f "$f" ]] && { echo "--- $(basename "$f")"; cat "$f"; }; done
  [[ -f "$FOLDER/.cards.json" ]] && { echo "--- .cards.json"; cat "$FOLDER/.cards.json"; }
  return 0
}

# The owner's clipboard waits here between `clip save` and `clip restore`.
SAVED_CLIPBOARD="$RUNS/saved-clipboard.plist"

clip() {
  [[ -x "$CLIP" ]] || die "not built; run: cards-verify build"
  case "${1:-}" in
    save)
      [[ -f "$SAVED_CLIPBOARD" ]] && die "the owner's clipboard is already saved; restore it first: cards-verify clip restore"
      mkdir -p "$RUNS"
      "$CLIP" save "$SAVED_CLIPBOARD" ;;
    restore) "$CLIP" restore "$SAVED_CLIPBOARD" ;;
    set)
      [[ -f "$SAVED_CLIPBOARD" ]] || die "save the owner's clipboard first: cards-verify clip save"
      shift; "$CLIP" set "$@" ;;
    show) "$CLIP" show ;;
    *) die "clip save | set TEXT [HTML] | show | restore" ;;
  esac
}

# The steps as the log keeps them: card text as a length, like `ax type`.
mcp_steps() {
  local out="mcp" step
  while (($#)); do
    step="$1"; shift
    out+=" $step"
    if [[ "$step" == add && $# -gt 0 ]]; then
      out+=" <${#1} characters>"; shift
      if [[ $# -gt 0 && -f "$1" ]]; then out+=" <body of $(wc -c < "$1" | tr -d ' ') bytes>"; shift; fi
    fi
  done
  echo "$out"
}

mcp() {
  current
  [[ -x "$MCP" ]] || die "not built; run: cards-verify build"
  ours || die "pid $PID is not this run's Cards; run: cards-verify doctor"
  log_line "$(mcp_steps "$@")" >> "$EVIDENCE/log.txt"
  "$MCP" "$HELPER" -CardsFolder "$FOLDER" "$@" | tee -a "$EVIDENCE/mcp.log"
}

frontmost() {
  local info
  info="$(lsappinfo info "$(lsappinfo front)")"
  echo "$(sed -n '1s/^"\(.*\)" ASN.*/\1/p' <<<"$info") (pid $(sed -n 's/.*pid = \([0-9]*\).*/\1/p' <<<"$info" | head -1))"
}

# What an AI tool does when Ideator is not running: the helper starts the app that contains it, with
# -CardsFolder, in the background. The run is adopted by its exact command line, as launch finds its pid.
mcp_launch() {
  [[ -x "$BIN" && -x "$MCP" ]] || die "not built; run: cards-verify build"
  if [[ -f "$RUNS/current.env" ]]; then
    current
    if ours; then die "run $RUN_ID (pid $PID) is still up; stop it first: cards-verify stop"; fi
    [[ -z "${LOCK_TOKEN:-}" ]] || live_lock_release "$LOCK_TOKEN" || true
  fi
  local run_id folder evidence pid="" before after lock_token
  run_id="$(date '+%Y%m%d-%H%M%S')"
  lock_token="cards-verify run $run_id in $REPO since $(date '+%H:%M:%S')"
  live_lock_take "$lock_token" || die "another live Ideator session holds $LIVE_LOCK (holder: $(live_lock_holder)); retry in 30 s"
  trap 'live_lock_release "$lock_token" || true' EXIT
  folder="${TMPDIR:-/tmp/}cards-verify/$run_id/folder"
  folder="${folder//\/\//\/}"
  evidence="$EVIDENCE_ROOT/$run_id"
  mkdir -p "$folder" "$evidence" "$RUNS"
  before="$(frontmost)"
  "$MCP" "$HELPER" -CardsFolder "$folder" "$@" | tee -a "$evidence/mcp.log"
  sleep 1
  after="$(frontmost)"
  # The binary too: the helper's own command line also ends in "-CardsFolder <folder>".
  pid="$(pgrep -f -- "^$BIN -CardsFolder $folder\$" || true)"
  [[ -n "$pid" ]] || die "the helper started no Ideator on $folder; see $evidence/mcp.log"
  printf 'RUN_ID=%q\nPID=%q\nFOLDER=%q\nEVIDENCE=%q\nLOCK_TOKEN=%q\n' "$run_id" "$pid" "$folder" "$evidence" "$lock_token" > "$RUNS/current.env"
  trap - EXIT
  current
  log "mcp-launch run $RUN_ID: $(mcp_steps "$@"); the helper started pid $PID on $FOLDER; frontmost app before: $before, after: $after"
  echo "evidence: $EVIDENCE"
}

stop() {
  if [[ -f "$SAVED_CLIPBOARD" ]]; then "$CLIP" restore "$SAVED_CLIPBOARD"; fi
  current
  if ours; then
    kill "$PID"
    for _ in $(seq 1 25); do ours || break; sleep 0.2; done
    ours && die "pid $PID did not quit"
    log "stopped pid $PID"
  else
    log "pid $PID already gone"
  fi
  if [[ -n "${LOCK_TOKEN:-}" ]]; then
    if live_lock_release "$LOCK_TOKEN"; then log "released $LIVE_LOCK"
    else log "left $LIVE_LOCK alone: this run does not hold it (holder: $(live_lock_holder))"; fi
  fi
  rm -rf "$(dirname "$FOLDER")"
  rm -f "$RUNS/current.env"
  echo "evidence kept in $EVIDENCE"
}

case "${1:-}" in
  build) build ;;
  launch) shift; launch "$@" ;;
  doctor) doctor ;;
  ax) shift; ax "$@" ;;
  shot) shot "${2:?NAME}" ;;
  files) files "${2:?NAME}" ;;
  note) current; log "${2:?TEXT}" ;;
  clip) shift; clip "$@" ;;
  mcp) shift; mcp "$@" ;;
  mcp-launch) shift; mcp_launch "$@" ;;
  stop) stop ;;
  env) current; cat "$RUNS/current.env" ;;
  *) usage ;;
esac
